# Variables de entorno del sitio.
# Copia este archivo a `.env` (ya está en .gitignore) y rellena los valores.
#
# Las de las Netlify Functions NUNCA se commitean ni llegan al frontend: solo
# viven en el servidor. La excepción está marcada abajo: las que llevan el
# prefijo `PUBLIC_` SÍ llegan al navegador, por diseño de Astro.

# ── Pixel de Meta (PÚBLICA: viaja al navegador) ──
# El identificador del pixel no es un secreto —cualquiera lo ve en el código de
# la página—, pero sí es configuración: por eso vive aquí y no incrustado en una
# plantilla. Vacía o ausente = el pixel NO se carga en ninguna página, acepte o
# no la persona las cookies publicitarias.
#
# Astro sustituye `import.meta.env.PUBLIC_*` en TIEMPO DE COMPILACIÓN: darla de
# alta en Netlify no surte efecto hasta el siguiente despliegue. Para probar en
# un deploy preview hay que darle alcance a los contextos de producción Y de
# deploy previews; con solo producción, la rama no tendrá pixel.
PUBLIC_META_PIXEL_ID=

# ── Anthropic — función de chat (Claude) ──
ANTHROPIC_API_KEY=

# ── ClickUp — función registrar-lead (espacio "LGO Abogados") ──
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# ── ClickUp — función m40-lead (lista "Amparo M40") ──
# Reutiliza CLICKUP_API_TOKEN de arriba. La lista es PROPIA: CLICKUP_LIST_ID ya
# apunta a la lista de /contratos y los leads de Modalidad 40 no deben caer ahí.
CLICKUP_M40_LIST_ID=

# ── Aviso de leads por correo (copia a contacto@lgo.mx) ──
LEAD_EMAIL_TO=contacto@lgo.mx
# Remitente: subdominio verificado en Resend (no-reply@send.lgo.mx).
LEAD_EMAIL_FROM=Asistente de Contratos LGO <no-reply@send.lgo.mx>
RESEND_API_KEY=

# ── Mercado Pago — Checkout Pro (funciones mp-*) ──
# PRUEBA: usa credenciales de TEST y MP_ENV=sandbox.
# PRODUCCIÓN: cambia a las credenciales LIVE (Access Token y Public Key de
#   producción) y MP_ENV=production. El MP_WEBHOOK_SECRET también es por entorno
#   (se genera en Tus integraciones → Webhooks de la app correspondiente).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_ENV=sandbox
