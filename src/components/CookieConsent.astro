---
// ════════════════════════════════════════════════════════════════
//  COOKIES — banner de consentimiento y gestor de preferencias
// ════════════════════════════════════════════════════════════════
//
// Cumple el apartado VIII del aviso de privacidad: ninguna cookie opcional
// —ni analíticas ni publicitarias— **se activa si la persona no la acepta**, y
// puede cambiar su elección cuando quiera desde «Configurar cookies», al pie de
// cada página.
//
// La copia del banner y las categorías viven las dos en @data/analytics: el
// texto resume las categorías y no debe poder quedarse atrás cuando cambien.
//
// Cómo funciona:
//   · Sin elección guardada, se muestra el banner. Nada de analítica corre
//     mientras tanto.
//   · «Aceptar todas» / «Solo las necesarias» deciden en un clic; «Configurar»
//     abre el panel con el detalle de cada categoría.
//   · La elección se guarda en localStorage (una cookie necesaria, según el
//     aviso) y se vuelve a preguntar si cambia el esquema de categorías.
//   · Al aceptar las analíticas se inyecta Google Tag Manager. Si el
//     contenedor no está configurado en @data/analytics, no se carga nada.
//   · Las publicitarias (pixel de Meta) NO se cargan aquí: este componente
//     publica el consentimiento y MetaPixel.astro lo aplica. El banner es la
//     única fuente de verdad; quien dependa de él consulta
//     `window.lgoConsentimiento()` al arrancar y escucha `lgo:consentimiento`
//     para los cambios posteriores, incluido el retiro.
//
// El botón del pie (`[data-configurar-cookies]`) reabre el panel; vive en
// Footer.astro para que esté en todas las páginas.
//
// Mientras el banner se ve, publica su alto en `--cookie-banner-alto` sobre
// `:root`, para que cualquier otro elemento fijo abajo pueda apoyarse encima
// en lugar de quedar debajo. Hoy lo usa la barra fija de la landing de
// Modalidad 40. Fuera de esos momentos vale `0px`.

import { BANNER_TITULO, BANNER_TEXTO, CATEGORIAS } from '@data/analytics';
---
<div class="cookies" data-cookies hidden>

  <!-- Banner: la primera pregunta, sin detalle -->
  <section
    class="cookie-banner"
    data-cookie-banner
    role="dialog"
    aria-modal="false"
    aria-labelledby="cookie-banner-titulo"
    hidden
  >
    <div class="cookie-banner-texto">
      <p class="cookie-banner-titulo" id="cookie-banner-titulo">{BANNER_TITULO}</p>
      <p>
        {BANNER_TEXTO}
        {' '}<a href="/aviso-de-privacidad/">Aviso de privacidad</a>.
        {' '}<button type="button" class="cookie-configurar" data-cookie-configurar>
          Configurar
        </button>
      </p>
    </div>
    <div class="cookie-banner-acciones">
      <button type="button" class="btn btn-ghost cookie-btn" data-cookie-necesarias>
        Solo necesarias
      </button>
      <button type="button" class="btn btn-primary cookie-btn" data-cookie-todas>
        Aceptar todas
      </button>
    </div>
  </section>

  <!-- Panel: el detalle por categoría -->
  <div class="cookie-fondo" data-cookie-fondo hidden></div>
  <section
    class="cookie-panel"
    data-cookie-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="cookie-panel-titulo"
    hidden
  >
    <header class="cookie-panel-head">
      <p class="cookie-panel-titulo" id="cookie-panel-titulo">Configurar cookies</p>
      <button type="button" class="cookie-cerrar" data-cookie-cerrar aria-label="Cerrar">
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="cookie-categorias">
      {CATEGORIAS.map((c) => (
        <div class="cookie-categoria">
          <label class="cookie-categoria-head" for={`cookie-${c.id}`}>
            <input
              type="checkbox"
              id={`cookie-${c.id}`}
              data-cookie-categoria={c.id}
              checked={c.obligatoria}
              disabled={c.obligatoria}
            />
            <span class="cookie-categoria-titulo">{c.titulo}</span>
            {c.obligatoria && <span class="cookie-siempre">Siempre activas</span>}
          </label>
          <p class="cookie-categoria-texto">{c.texto}</p>
        </div>
      ))}
    </div>

    <footer class="cookie-panel-pie">
      <a href="/aviso-de-privacidad/" class="cookie-enlace">Aviso de privacidad</a>
      <button type="button" class="btn btn-primary cookie-btn" data-cookie-guardar>
        Guardar preferencias
      </button>
    </footer>
  </section>
</div>

<style>
  .cookies { position: relative; z-index: 400; }

  /* ── Banner ── */
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 401;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem max(1rem, env(safe-area-inset-right, 0px))
      calc(1.25rem + env(safe-area-inset-bottom, 0px)) max(1rem, env(safe-area-inset-left, 0px));
    background: var(--color-foreground-strong);
    color: var(--color-on-dark);
    border-top: 3px solid var(--color-accent);
  }
  @media (min-width: 900px) {
    .cookie-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding-inline: 3rem;
      /* «Configurar» dentro del párrafo le suma un renglón al texto, y en
         escritorio el texto es lo más alto del banner. Estos 8 px menos de
         aire arriba y abajo devuelven el banner a los 110 px que medía, que
         es lo que un portátil de 1280 × 800 necesita para que el botón de
         WhatsApp del encabezado siga completo. */
      padding-block: 0.75rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    }
  }

  .cookie-banner-texto { max-width: 62ch; }
  .cookie-banner-titulo {
    margin: 0 0 0.375rem;
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-on-dark);
  }
  .cookie-banner p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: rgba(250, 248, 244, 0.85);
  }
  .cookie-banner a { color: var(--color-accent-soft); font-weight: 700; }

  /* «Configurar» viaja dentro del párrafo y no en una fila propia: esa fila
     costaba 40 px del primer pantallazo en móvil. Sigue siendo un botón de
     verdad —el foco visible se lo da el `:focus-visible` global— y el relleno
     vertical le da área de toque sin gastar alto, porque el relleno de un
     elemento en línea no estira la línea que lo contiene. */
  .cookie-configurar {
    display: inline;
    padding: 0.5rem 0.25rem;
    margin: 0 -0.25rem;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--color-accent-soft);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .cookie-configurar:hover { color: var(--color-on-dark); }

  .cookie-banner-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .cookie-btn { flex: 1 1 auto; white-space: nowrap; }
  @media (min-width: 900px) { .cookie-btn { flex: 0 0 auto; } }
  .cookie-banner .btn-ghost {
    color: var(--color-on-dark);
    border-color: rgba(250, 248, 244, 0.4);
  }
  .cookie-banner .btn-ghost:hover {
    background: rgba(250, 248, 244, 0.08);
    border-color: var(--color-on-dark);
  }

  /* En móvil el banner se queda con lo imprescindible: en una landing el
     primer pantallazo tiene que seguir mostrando su oferta. El título sigue
     ahí para `aria-labelledby`, solo deja de pintarse.

     Las dos decisiones —aceptar todas y solo las necesarias— comparten una
     sola fila y conservan el mismo peso, que es lo que un banner honesto
     exige. «Configurar» va dentro del párrafo, no en una fila propia.

     Alto real medido a 360 × 740 con las tres categorías en el texto:
     185 px antes de sacar «Configurar» de su fila, 157 px después. El
     presupuesto de ~140 px que decía este comentario se escribió cuando el
     texto nombraba dos categorías; con tres ocupa cuatro renglones y ese
     número dejó de corresponder. En escritorio mide 110 px. */
  @media (max-width: 899px) {
    .cookie-banner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 0.625rem;
      padding-block: 0.625rem;
    }
    .cookie-banner-titulo {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .cookie-banner-texto { grid-column: 1 / -1; }
    .cookie-banner p { font-size: var(--text-xs); }

    .cookie-banner-acciones { display: contents; }
  }

  /* ── Panel ── */
  .cookie-fondo {
    position: fixed;
    inset: 0;
    z-index: 402;
    background: rgba(26, 26, 26, 0.55);
  }
  .cookie-panel {
    position: fixed;
    z-index: 403;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(34rem, calc(100vw - 2rem));
    max-height: min(42rem, calc(100vh - 2rem));
    overflow-y: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
  }

  .cookie-panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .cookie-panel-titulo {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-foreground-strong);
  }
  .cookie-cerrar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-muted);
    cursor: pointer;
  }
  .cookie-cerrar:hover { border-color: var(--color-accent); color: var(--color-accent-strong); }

  .cookie-categorias { display: flex; flex-direction: column; gap: 1.25rem; }
  .cookie-categoria {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-divider);
  }
  .cookie-categoria:last-child { border-bottom: 0; padding-bottom: 0; }

  .cookie-categoria-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    cursor: pointer;
    margin-bottom: 0.5rem;
  }
  .cookie-categoria-head input {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-accent);
    flex-shrink: 0;
  }
  .cookie-categoria-head input:disabled { cursor: not-allowed; }
  .cookie-categoria-titulo {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-foreground-strong);
  }
  .cookie-siempre {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cookie-categoria-texto {
    margin: 0;
    padding-left: 1.75rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .cookie-panel-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .cookie-enlace { font-size: var(--text-sm); font-weight: 700; color: var(--color-accent-deep); }
</style>

<script>
  import {
    GTM_ID,
    CONSENT_KEY,
    CONSENT_VERSION,
    EVENTO_CONSENTIMIENTO,
    type ConsentimientoCookies
  } from '@data/analytics';

  const raiz = document.querySelector<HTMLElement>('[data-cookies]');

  if (raiz) {
    const banner = raiz.querySelector<HTMLElement>('[data-cookie-banner]')!;
    const panel = raiz.querySelector<HTMLElement>('[data-cookie-panel]')!;
    const fondo = raiz.querySelector<HTMLElement>('[data-cookie-fondo]')!;

    // Las casillas se resuelven por su categoría, no una por una: al agregar
    // una categoría en @data/analytics el panel la pinta y este script la
    // encuentra sin más cambios.
    const casillas = new Map<string, HTMLInputElement>();
    raiz.querySelectorAll<HTMLInputElement>('[data-cookie-categoria]').forEach((c) => {
      casillas.set(c.dataset.cookieCategoria!, c);
    });
    const casillaAnaliticas = casillas.get('analiticas')!;
    const casillaPublicitarias = casillas.get('publicitarias')!;

    // ── Almacenamiento ──
    // localStorage puede fallar (ventana privada, datos bloqueados): en ese
    // caso la elección vale para esta sesión y el banner volverá a aparecer,
    // que es el comportamiento seguro.
    const leer = (): ConsentimientoCookies | null => {
      try {
        const crudo = localStorage.getItem(CONSENT_KEY);
        if (!crudo) return null;
        const dato = JSON.parse(crudo);
        if (!dato || dato.version !== CONSENT_VERSION) return null;
        return {
          version: dato.version,
          analiticas: dato.analiticas === true,
          publicitarias: dato.publicitarias === true,
          fecha: dato.fecha
        };
      } catch {
        return null;
      }
    };

    const guardar = (analiticas: boolean, publicitarias: boolean) => {
      const dato: ConsentimientoCookies = {
        version: CONSENT_VERSION,
        analiticas,
        publicitarias,
        fecha: new Date().toISOString()
      };
      try {
        localStorage.setItem(CONSENT_KEY, JSON.stringify(dato));
      } catch {
        // Sin almacenamiento la elección no persiste; se respeta en esta carga.
      }
      aplicar(dato);
    };

    // ── Google Tag Manager, solo con consentimiento ──
    let gtmCargado = false;
    const cargarGtm = () => {
      if (gtmCargado || !GTM_ID) return;
      gtmCargado = true;
      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`;
      document.head.appendChild(s);
    };

    // ── Estado vigente, legible desde fuera ──
    //
    // Hacen falta DOS vías, no una. Los scripts que dependen del consentimiento
    // se cargan en paralelo con este y el orden no está garantizado: si el
    // banner aplica la elección guardada antes de que el otro script registre
    // su escucha, el evento ya pasó y se perdería. Por eso el estado también
    // queda consultable: `window.lgoConsentimiento()` al arrancar, y el evento
    // para todo cambio posterior.
    //
    // Solo lectura y copia congelada: el banner sigue siendo la única fuente de
    // verdad y nadie de fuera puede cambiar la elección de la persona.
    let estado: ConsentimientoCookies | null = null;

    if (!('lgoConsentimiento' in window)) {
      Object.defineProperty(window, 'lgoConsentimiento', {
        value: () => (estado ? Object.freeze({ ...estado }) : null),
        writable: false,
        configurable: false
      });
    }

    const aplicar = (dato: ConsentimientoCookies) => {
      estado = dato;
      if (dato.analiticas) cargarGtm();
      casillaAnaliticas.checked = dato.analiticas;
      casillaPublicitarias.checked = dato.publicitarias;
      // Se avisa siempre, también cuando se retira el consentimiento: quien
      // dependa de él tiene que poder dejar de enviar en el acto.
      window.dispatchEvent(
        new CustomEvent(EVENTO_CONSENTIMIENTO, { detail: Object.freeze({ ...dato }) })
      );
    };

    // ── Alto del banner, publicado para quien se apoye en él ──
    //
    // La landing de Modalidad 40 tiene su propia barra fija abajo. Las dos
    // viven en `bottom: 0`, así que sin esto la barra queda sepultada bajo el
    // banner y su botón es inalcanzable mientras nadie responde. El alto no se
    // puede escribir a mano: depende del texto, del ancho de la pantalla y de
    // la tipografía ya cargada. Se mide aquí y se publica en `:root`; vale
    // `0px` cuando el banner no está a la vista.
    const publicarAlto = () => {
      const alto = banner.hidden ? 0 : Math.round(banner.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--cookie-banner-alto', `${alto}px`);
    };

    // El alto cambia al girar el teléfono y cuando la tipografía termina de
    // cargar y el texto se reacomoda, no solo al mostrar u ocultar. Las dos
    // primeras vías no dependen del ciclo de pintado; el observador es un
    // extra para cualquier otro reflujo.
    window.addEventListener('resize', publicarAlto);
    document.fonts?.ready.then(publicarAlto);
    if ('ResizeObserver' in window) new ResizeObserver(publicarAlto).observe(banner);

    // Único lugar donde el banner aparece o se va: así el alto publicado no
    // puede quedarse atrás si mañana se agrega otro camino.
    const mostrarBanner = (visible: boolean) => {
      banner.hidden = !visible;
      publicarAlto();
    };

    // ── Mostrar y ocultar ──
    const cerrarPanel = () => {
      panel.hidden = true;
      fondo.hidden = true;
      document.removeEventListener('keydown', alEscape);
    };

    const alEscape = (ev: KeyboardEvent) => {
      if (ev.key === 'Escape') cerrarPanel();
    };

    const abrirPanel = () => {
      const actual = leer();
      casillaAnaliticas.checked = actual ? actual.analiticas : false;
      casillaPublicitarias.checked = actual ? actual.publicitarias : false;
      mostrarBanner(false);
      fondo.hidden = false;
      panel.hidden = false;
      document.addEventListener('keydown', alEscape);
      panel.querySelector<HTMLElement>('[data-cookie-cerrar]')?.focus();
    };

    const decidir = (analiticas: boolean, publicitarias: boolean) => {
      guardar(analiticas, publicitarias);
      mostrarBanner(false);
      cerrarPanel();
    };

    // ── Eventos ──
    raiz.querySelector('[data-cookie-todas]')!.addEventListener('click', () => decidir(true, true));
    raiz
      .querySelector('[data-cookie-necesarias]')!
      .addEventListener('click', () => decidir(false, false));
    raiz.querySelector('[data-cookie-configurar]')!.addEventListener('click', abrirPanel);
    raiz.querySelector('[data-cookie-cerrar]')!.addEventListener('click', cerrarPanel);
    fondo.addEventListener('click', cerrarPanel);
    raiz
      .querySelector('[data-cookie-guardar]')!
      .addEventListener('click', () =>
        decidir(casillaAnaliticas.checked, casillaPublicitarias.checked)
      );

    // «Configurar cookies» del pie: reabre el panel en cualquier momento.
    document.querySelectorAll('[data-configurar-cookies]').forEach((b) =>
      b.addEventListener('click', (ev) => {
        ev.preventDefault();
        abrirPanel();
      })
    );

    // ── Arranque ──
    raiz.hidden = false;
    const guardado = leer();
    if (guardado) aplicar(guardado);
    else mostrarBanner(true);
  }
</script>
