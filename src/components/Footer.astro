---
import Logo from '@components/Logo.astro';
import { business } from '@data/business';
import { nav } from '@data/nav';
import { publishedSubBrands, publishedExternalBrands } from '@data/brands';
import { AVISO_PRIVACIDAD_PATH } from '@data/aviso-privacidad';

const year = 2026;  // estampado en build; actualizar manualmente (no Date.now por workflow)
---
<footer class="site-footer">
  <div class="container-base footer-grid">

    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={`${business.brand} — Inicio`}>
        {/* Igual que en el nav: el nombre lo pone el aria-label del enlace. */}
        <Logo brand="grupo" height={44} alt="" />
      </a>
      <p class="footer-tagline">{business.tagline}</p>
      <p class="footer-address">{business.address.full}</p>
    </div>

    <div>
      <div class="footer-col-title">Ecosistema</div>
      <ul class="footer-nav footer-ecosistema">
        {publishedSubBrands.map((b) => (
          <li>
            {/* El nombre lo pone el <span class="sr-only">; el alt del
                logotipo lo repetiría, así que la imagen va como decorativa. */}
            <a href={b.url} class="footer-ecosistema-item">
              <Logo brand={b.id as any} height={26} alt="" />
              <span class="sr-only">{b.name}</span>
            </a>
          </li>
        ))}
        {publishedExternalBrands.map((b) => (
          <li>
            <a href={b.url} target="_blank" rel="noopener" class="footer-ecosistema-text">
              {b.shortName} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="footer-col-title">Navegación</div>
      {/* Un grupo sin página propia (Servicios abre dropdown, no navega) apunta
          al grid del ecosistema en el home; el resto usa su href. Evita el
          <a> sin href. */}
      <ul class="footer-nav">
        {nav.map((item) => (
          <li><a href={item.href ?? '/#ecosistema'}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <div class="footer-col-title">Contacto</div>
      <ul class="footer-nav">
        <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
        <li><a href={`tel:${business.phoneE164}`}>{business.phone}</a></li>
        <li><a href={business.whatsappUrl} target="_blank" rel="noopener">WhatsApp</a></li>
        <li class="footer-hours">{business.hours.label}</li>
      </ul>
    </div>

  </div>

  <div class="container-base footer-bottom">
    <span>© {year} {business.brand}. Todos los derechos reservados.</span>

    {/* Legal: el aviso es obligación de publicidad (artículo 15 de la Ley) y
        «Configurar cookies» reabre el gestor de consentimiento, como promete
        el apartado VIII del propio aviso. */}
    <nav class="footer-legal" aria-label="Legal">
      <a href={AVISO_PRIVACIDAD_PATH}>Aviso de privacidad</a>
      <button type="button" class="footer-legal-btn" data-configurar-cookies>
        Configurar cookies
      </button>
    </nav>

    <span>{business.address.locality}, {business.address.region}, {business.address.country}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-foreground-strong);
    color: var(--color-on-dark);
    padding-block: 3.5rem 2rem;
    border-top: 3px solid var(--color-accent);
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 640px)  { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .footer-grid { grid-template-columns: 2fr 1.2fr 1fr 1.2fr; } }

  /* Logo del footer (sobre fondo oscuro: contenedor blanco para el PNG). */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    text-decoration: none;
    transition: opacity 200ms ease;
  }
  .footer-logo:hover { opacity: 0.85; }

  .footer-tagline {
    font-size: var(--text-sm);
    color: rgba(250,248,244,0.65);
    max-width: 30ch;
    margin-bottom: 0.75rem;
    line-height: 1.55;
  }
  .footer-address {
    font-size: var(--text-xs);
    color: rgba(250,248,244,0.55);
    line-height: 1.55;
  }

  .footer-col-title {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* 0.55 sobre el fondo del pie da 5.7:1; con 0.45 se quedaba en 4.3. */
    color: rgba(250,248,244,0.55);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-nav a {
    font-size: var(--text-sm);
    color: rgba(250,248,244,0.78);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .footer-nav a:hover { color: var(--color-on-dark); }

  /* Items del ecosistema con logo: contenedor blanco para el PNG sobre fondo oscuro */
  .footer-ecosistema { gap: 0.75rem; }
  .footer-ecosistema-item {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.7rem;
    background: var(--color-surface);
    border-radius: var(--radius-xs);
    transition: opacity 200ms ease;
    align-self: flex-start;
  }
  .footer-ecosistema-item:hover { opacity: 0.85; }
  .footer-ecosistema-text {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    color: rgba(250,248,244,0.78);
    text-decoration: none;
    padding-block: 0.4rem;
  }
  .footer-ecosistema-text:hover { color: var(--color-on-dark); }

  .footer-hours {
    font-size: var(--text-xs);
    color: rgba(250,248,244,0.55);
    margin-top: 0.25rem;
  }

  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(250,248,244,0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    font-size: var(--text-xs);
    /* Misma razón que .footer-col-title: 0.38 se quedaba en 3.4:1. */
    color: rgba(250,248,244,0.55);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }
  .footer-legal a,
  .footer-legal-btn {
    font-family: inherit;
    font-size: var(--text-xs);
    color: rgba(250,248,244,0.6);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
  }
  .footer-legal a:hover,
  .footer-legal-btn:hover { color: var(--color-on-dark); text-decoration: underline; }
  .footer-legal a:focus-visible,
  .footer-legal-btn:focus-visible { outline: 2px solid var(--color-accent-soft); outline-offset: 3px; }
</style>
