---
// Visual esquemático (aria-hidden) para el teaser de /marcas: un mini
// "expediente de plazos" con renovación y estado. Se pasa como slot "visual"
// de HerramientaFeature desde Inicio y desde /abogados. Estilos propios y
// scoped para poder reutilizarlo sin duplicar CSS en cada página.
---
<div class="marca-mock" aria-hidden="true">
  <div class="marca-mock-head">
    <span class="marca-mock-badge"></span>
    <span class="marca-mock-tag">Renovación</span>
  </div>
  <div class="marca-mock-row">
    <span class="marca-mock-lbl"></span>
    <span class="marca-mock-date"></span>
  </div>
  <div class="marca-mock-row">
    <span class="marca-mock-lbl marca-mock-lbl--short"></span>
    <span class="marca-mock-date"></span>
  </div>
  <div class="marca-mock-row">
    <span class="marca-mock-lbl"></span>
    <span class="marca-mock-date marca-mock-date--accent"></span>
  </div>
  <span class="marca-mock-state"></span>
</div>

<style>
  .marca-mock {
    position: absolute;
    right: 1.5rem; top: 0.25rem;
    width: 15rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border-top: 3px solid var(--color-accent);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55);
  }
  .marca-mock-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.15rem;
  }
  .marca-mock-badge { width: 2.2rem; height: 0.55rem; border-radius: 2px; background: var(--color-accent); }
  .marca-mock-tag {
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.2rem 0.45rem; border-radius: var(--radius-xs);
    color: var(--color-accent-deep); background: var(--color-accent-soft);
  }
  .marca-mock-row { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .marca-mock-lbl { height: 0.5rem; width: 55%; border-radius: 2px; background: var(--color-gray-150); }
  .marca-mock-lbl--short { width: 40%; }
  .marca-mock-date { height: 0.5rem; width: 3.5rem; border-radius: 2px; background: var(--color-gray-200); }
  .marca-mock-date--accent { background: var(--color-accent); }
  .marca-mock-state {
    align-self: flex-start; margin-top: 0.15rem;
    width: 6rem; height: 1.15rem; border-radius: var(--radius-xs);
    background: rgba(91, 140, 112, 0.18);
    border-left: 3px solid var(--color-success);
  }
</style>
