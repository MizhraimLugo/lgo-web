    /* Mientras la barra está arriba, el documento reserva su altura: así no
       tapa el final del contenido ni el pie. */
    :global(body:has([data-barra][data-visible='true'])) { padding-bottom: 4.5rem; }
    /* Con el menú móvil abierto la barra se retira: son dos capas fijas. */
    :global(body:has([data-mobile-menu]:not([hidden]))) .barra { transform: translateY(110%); }
  }
</style>

<script>
  import { lanzamientoVigente } from '@data/amparo-m40';

  // ── 1. Precio de lanzamiento ──
  // La página es estática: si nadie publica un deploy justo después de la
  // fecha, el tachado seguiría visible. Esta comprobación en el cliente lo
  // retira igualmente y descubre el precio de lista, con la zona horaria de la
  // sección.
  if (!lanzamientoVigente()) {
    document.querySelectorAll<HTMLElement>('[data-lanzamiento]').forEach((el) => el.remove());
    document.querySelectorAll<HTMLElement>('[data-post-lanzamiento]').forEach((el) => {
      el.hidden = false;
    });
  }

  // ── 2. Barra fija del móvil ──
  // Aparece cuando el encabezado termina de salir de pantalla y se esconde
  // donde la página ya ofrece su propio botón: la autoevaluación, el cierre y
  // el pie. Así nunca compite con un CTA ni tapa el formulario de captura.
  const barra = document.querySelector<HTMLElement>('[data-barra]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (barra && hero && 'IntersectionObserver' in window) {
    const zonasPropias = [
      document.getElementById('autoevaluacion'),
      document.querySelector('[data-cierre]'),
      document.querySelector('.site-footer')
    ].filter((el): el is HTMLElement => el instanceof HTMLElement);

    let heroFuera = false;
    const visibles = new Set<Element>();

    const pintar = () => {
      barra.dataset.visible = String(heroFuera && visibles.size === 0);
    };

    new IntersectionObserver(([entrada]) => {
      heroFuera = !entrada.isIntersecting;
      pintar();
    }).observe(hero);

    const observador = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (e.isIntersecting) visibles.add(e.target);
        else visibles.delete(e.target);
      }
      pintar();
    });
    zonasPropias.forEach((el) => observador.observe(el));
  }
</script>
