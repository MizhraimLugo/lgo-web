  .precio-ahora--chico { font-size: var(--text-3xl); color: var(--color-foreground-strong); }
  .precio-iva {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .precio-cond {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-foreground-strong);
  }

  .incluye {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.625rem;
    margin: 0 0 1.5rem;
