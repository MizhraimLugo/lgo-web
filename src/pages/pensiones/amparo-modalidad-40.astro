  }
  .incluye .ico { width: 1rem; height: 1rem; color: var(--color-success); }

  .precio-desc { margin: 0 0 1.5rem; font-size: var(--text-sm); color: var(--color-muted); }
  .precio .btn { width: 100%; }
  .precio:not(.precio--destacado) .precio-desc { margin-bottom: 0; }

  .familia {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 46rem;
    margin: 1.75rem 0 0;
    padding: 1rem 1.25rem;
    background: var(--color-accent-soft);
    border-radius: 999px;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-accent-deep);
  }
  .familia .ico { color: var(--color-accent-strong); margin-top: 0.1rem; }
  .familia strong { font-weight: 700; }
  @media (max-width: 520px) { .familia { border-radius: var(--radius-sm); } }

  .letra-fina {
    margin: 1.5rem 0 0;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 62ch;
  }

  /* ── 4.8 CLARIDADES ── */
  .claridades { display: grid; grid-template-columns: 1fr; gap: 0.875rem; }
  @media (min-width: 680px) { .claridades { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .claridades { grid-template-columns: repeat(3, 1fr); } }
  .claridad {
    /* Crema sobre banda blanca: antes era al revés. */
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.375rem;
  }
  .claridad h3 { margin: 0 0 0.5rem; font-size: var(--text-base); }
  .claridad p { margin: 0; font-size: var(--text-sm); line-height: 1.6; color: var(--color-muted); }

  /* ── 4.9 FAQ ── */
  .faq-cta { margin-top: 2rem; }

  /* ── 4.10 CHECKLIST ── */
  /* Una sola columna. En dos, los cinco puntos dejaban filas de altura
     dispar —unos caben en un renglón y otros no— y el último se quedaba
     solo en la última fila. Es una lista para ir tachando: se lee hacia
     abajo. */
  .checklist {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 40rem;
  }
  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: var(--text-base);
    line-height: 1.5;
  }
  .casilla {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-xs);
    background: var(--color-surface);
    color: var(--color-accent-strong);
  }
  .casilla .ico { width: 0.875rem; height: 0.875rem; stroke-width: 2.4; }

  /* ── 4.11 QUIÉN TE ATIENDE ── */
  .quien { max-width: 44rem; }
  .quien h2 { margin: 1rem 0 0.5rem; font-size: var(--text-3xl); }
  .quien-cargo {
    margin: 0 0 0.5rem;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-foreground-strong);
  }
  .quien-sede { margin: 0 0 1.25rem; font-size: var(--text-sm); color: var(--color-muted); }
  .quien-enlace {
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-muted);
  }
  .quien-enlace a { color: var(--color-accent-strong); font-weight: 600; text-decoration: underline; }

  .quien-frase {
    margin: 0;
    padding-left: 1.125rem;
    border-left: 3px solid var(--color-accent);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-foreground-strong);
  }

  /* ── 4.12 CIERRE ── */
  .cierre { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .cierre h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.875rem, 1.4rem + 2.4vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }
  .cierre-sub { margin: 0 0 1.75rem; font-size: var(--text-lg); max-width: 40ch; }
  .cierre-contador { margin-bottom: 1.75rem; text-align: left; }

  /* ── 4.13 AVISOS ── */
  .avisos {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: var(--container-prose);
  }
  /* `muted-soft` (#909090) se queda en 2.9:1 sobre el fondo del sitio: en
     texto chico no alcanza, así que los avisos van con el gris medio. */
  .avisos li { font-size: var(--text-xs); line-height: 1.6; color: var(--color-muted); }
  .avisos a { color: var(--color-muted); font-weight: 600; }

  /* ── BARRA FIJA (móvil) ──
     PENDIENTE, para un PR posterior: mientras el banner de cookies está sin
     responder, esta barra queda íntegramente debajo de él —los dos van en
     `bottom: 0` y el banner tiene z-index 401 contra 150—, así que el CTA de
     toda la página es inalcanzable para quien aún no ha elegido, que con
     `CONSENT_VERSION` en 2 es todo el mundo. La solución estudiada es
     apoyarla encima del banner (`bottom` igual al alto del banner, por arriba
     en z-index), lo que exige que el banner publique su alto real como
     variable CSS. Este PR arregla el encabezado; la barra sigue tapada. */
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 150;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    padding-bottom: calc(0.625rem + env(safe-area-inset-bottom, 0px));
    background: var(--color-foreground-strong);
    border-top: 1px solid rgba(250, 248, 244, 0.16);
    transform: translateY(110%);
    transition: transform 260ms ease;
  }
  @media (max-width: 819px) { .barra { display: flex; } }
  .barra[data-visible='true'] { transform: translateY(0); }

  .barra-txt {
    display: flex;
    flex-direction: column;
    font-size: var(--text-xs);
    line-height: 1.3;
    color: rgba(250, 248, 244, 0.75);
  }
  .barra-txt strong { font-size: var(--text-base); color: var(--color-on-dark); }
  .barra-btn { flex-shrink: 0; padding-inline: 1.25rem; }

  @media (max-width: 819px) {
    /* Mientras la barra está arriba, el documento reserva su altura: así no
       tapa el final del contenido ni el pie. */
    :global(body:has([data-barra][data-visible='true'])) { padding-bottom: 4.5rem; }
    /* Con el menú móvil abierto la barra se retira: son dos capas fijas. */
    :global(body:has([data-mobile-menu]:not([hidden]))) .barra { transform: translateY(110%); }
  }
</style>

<script>
  import { lanzamientoVigente } from '@data/amparo-m40';

  // ── 1. Precio de lanzamiento ──
  // La página es estática: si nadie publica un deploy justo después de la
  // fecha, el tachado seguiría visible. Esta comprobación en el cliente lo
  // retira igualmente y descubre el precio de lista, con la zona horaria de la
  // sección.
  if (!lanzamientoVigente()) {
    document.querySelectorAll<HTMLElement>('[data-lanzamiento]').forEach((el) => el.remove());
    document.querySelectorAll<HTMLElement>('[data-post-lanzamiento]').forEach((el) => {
      el.hidden = false;
    });
  }

  // ── 2. Barra fija del móvil ──
  // Aparece cuando el encabezado termina de salir de pantalla y se esconde
  // donde la página ya ofrece su propio botón: la autoevaluación, el cierre y
  // el pie. Así nunca compite con un CTA ni tapa el formulario de captura.
  const barra = document.querySelector<HTMLElement>('[data-barra]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (barra && hero && 'IntersectionObserver' in window) {
    const zonasPropias = [
      document.getElementById('autoevaluacion'),
      document.querySelector('[data-cierre]'),
      document.querySelector('.site-footer')
    ].filter((el): el is HTMLElement => el instanceof HTMLElement);

    let heroFuera = false;
    const visibles = new Set<Element>();

    const pintar = () => {
      barra.dataset.visible = String(heroFuera && visibles.size === 0);
    };

    new IntersectionObserver(([entrada]) => {
      heroFuera = !entrada.isIntersecting;
      pintar();
    }).observe(hero);

    const observador = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (e.isIntersecting) visibles.add(e.target);
        else visibles.delete(e.target);
      }
      pintar();
    });
    zonasPropias.forEach((el) => observador.observe(el));
  }
</script>
