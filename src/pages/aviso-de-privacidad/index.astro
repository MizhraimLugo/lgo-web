---
// ════════════════════════════════════════════════════════════════
//  AVISO DE PRIVACIDAD INTEGRAL (/aviso-de-privacidad/)
// ════════════════════════════════════════════════════════════════
//
// Renderiza src/content/legal/aviso-de-privacidad.md. El Markdown NO lleva
// su propio H1 ni la fecha: los compone esta página desde el frontmatter, de
// modo que el documento tenga un solo <h1> y la fecha mostrada no pueda
// separarse de `lastUpdated`.
//
// Los Anexos A y B no son parte de este documento: viven en
// @data/aviso-privacidad, que alimenta el aviso simplificado de los
// formularios y la leyenda de WhatsApp.
//
// Página indexable (sin `noindex`) y con canónica propia: el aviso es una
// obligación de publicidad del artículo 15 de la Ley, y debe poder citarse.

import { getEntry, render } from 'astro:content';
import Base from '@layouts/Base.astro';
import { business } from '@data/business';
import { AVISO_PRIVACIDAD_PATH, AVISO_PRIVACIDAD_CORREO } from '@data/aviso-privacidad';

const entrada = await getEntry('legal', 'aviso-de-privacidad');
if (!entrada) throw new Error('Falta src/content/legal/aviso-de-privacidad.md');

const { Content } = await render(entrada);
const { title, description, lastUpdated, privacyVersion } = entrada.data;

const path = AVISO_PRIVACIDAD_PATH;

const MESES = [
  'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
  'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'
];

/** 'YYYY-MM-DD' → "26 de octubre de 2026", sin depender de la zona horaria. */
function fechaLarga(iso: string): string {
  const [a, m, d] = iso.split('-').map(Number);
  return `${d} de ${MESES[m - 1]} de ${a}`;
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: business.url + '/' },
    { '@type': 'ListItem', position: 2, name: title, item: business.url + path }
  ]
};

const paginaLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${business.url}${path}#webpage`,
  name: title,
  description,
  url: business.url + path,
  inLanguage: 'es-MX',
  dateModified: lastUpdated,
  isPartOf: { '@id': `${business.url}/#website` },
  publisher: { '@id': `${business.url}/#organization` }
};
---
<Base
  title={`${title} | ${business.brand}`}
  description={description}
  path={path}
  extraJsonLd={[breadcrumbLd, paginaLd]}
>
  <article class="aviso section">
    <div class="container-narrow">

      <header class="aviso-head">
        <span class="eyebrow">{business.brand}</span>
        <h1>{title}</h1>
        <p class="aviso-fecha">
          Última actualización:
          <time datetime={lastUpdated}>{fechaLarga(lastUpdated)}</time>
          <span class="aviso-version">Versión {privacyVersion}</span>
        </p>
        <hr class="aviso-rule" aria-hidden="true" />
      </header>

      <div class="aviso-body prose-lgo">
        <Content />
      </div>

      <footer class="aviso-pie">
        <p>
          Para ejercer sus derechos o resolver cualquier duda sobre este aviso, escriba al
          Departamento de Datos Personales de {business.brand}:
          {' '}<a href={`mailto:${AVISO_PRIVACIDAD_CORREO}`}>{AVISO_PRIVACIDAD_CORREO}</a>.
        </p>
      </footer>

    </div>
  </article>
</Base>

<style>
  .aviso-head { margin-bottom: 2.5rem; }
  .aviso-head h1 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(1.875rem, 1.4rem + 2.4vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 22ch;
    text-wrap: balance;
  }
  .aviso-fecha {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .aviso-fecha time { font-weight: 700; color: var(--color-foreground-strong); }
  .aviso-version {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* `muted-soft` no alcanza 4.5:1 a 13 px sobre el fondo del sitio. */
    color: var(--color-muted);
  }
  .aviso-rule {
    margin: 1.75rem 0 0;
    border: 0;
    border-top: 2px solid var(--color-foreground-strong);
  }

  /* ── Cuerpo del documento ──
     El Markdown llega sin clases, así que se estiliza por elemento dentro
     de .aviso-body. `:global` porque el HTML lo inyecta <Content />. */
  .aviso-body :global(h2) {
    margin: 3rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-divider);
    font-size: var(--text-2xl);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .aviso-body :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .aviso-body :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: var(--text-lg);
    color: var(--color-foreground-strong);
  }
  .aviso-body :global(p) {
    margin: 0 0 1.1rem;
    font-size: var(--text-base);
    line-height: 1.75;
  }
  .aviso-body :global(strong) { color: var(--color-foreground-strong); font-weight: 700; }

  .aviso-body :global(ul),
  .aviso-body :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .aviso-body :global(ul) { list-style: none; padding-left: 1.25rem; }
  .aviso-body :global(ol) { list-style: decimal; }
  .aviso-body :global(li) {
    font-size: var(--text-base);
    line-height: 1.7;
    position: relative;
  }
  .aviso-body :global(ul > li)::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 0.72rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* La tabla de transferencias es el único bloque que no cabe en un móvil:
     va dentro de .tabla-ancha (un <div> puesto en el propio Markdown) y se
     desplaza sola, sin que la página entera scrollee de lado. */
  .aviso-body :global(.tabla-ancha) {
    margin: 0 0 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .aviso-body :global(table) {
    width: 100%;
    min-width: 30rem;
    margin: 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .aviso-body :global(th),
  .aviso-body :global(td) {
    text-align: left;
    padding: 0.75rem 0.875rem;
    border-bottom: 1px solid var(--color-divider);
    vertical-align: top;
  }
  .aviso-body :global(th) {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-bottom: 2px solid var(--color-border-strong);
  }
  .aviso-body :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-divider);
  }

  .aviso-pie {
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface-alt);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-xs);
  }
  .aviso-pie p { margin: 0; font-size: var(--text-sm); line-height: 1.7; color: var(--color-muted); }
  .aviso-pie a { font-weight: 700; color: var(--color-accent-deep); }
</style>
