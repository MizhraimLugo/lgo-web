---
import '../styles/global.css';
import Seo from '@components/Seo.astro';
import Nav from '@components/Nav.astro';
import CookieConsent from '@components/CookieConsent.astro';
import MetaPixel from '@components/MetaPixel.astro';
import Footer from '@components/Footer.astro';
import JsonLd from '@components/JsonLd.astro';
import { business } from '@data/business';
import { publishedSubBrands } from '@data/brands';

export interface Props {
  title: string;
  description: string;
  path: string;
  /** Override del canonical (path relativo). Si se omite, es self-referential desde `path`. */
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'business.business';
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Nombre de la página para el `ViewContent` del pixel de Meta. Solo lo pasan
   * las páginas que se miden como contenido propio (p. ej. la landing de
   * Modalidad 40); el resto emite únicamente `PageView`.
   */
  pixelViewContent?: string;
}

const { title, description, path, canonical, ogImage, noindex, type, extraJsonLd, pixelViewContent } =
  Astro.props;

// Cada sub-marca publicada como Organization independiente.
// Esto permite que Google y modelos de IA entiendan el ecosistema:
// Grupo LGO opera múltiples prácticas complementarias bajo una identidad común.
// Las sub-marcas reservadas (tecnologia, marketing) NO entran al schema hasta
// que su `published: true` lo permita — evita confusión SEO sobre servicios
// que aún no se ofrecen al público.
const subBrandOrgs = publishedSubBrands.map((b) => ({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${business.url}/#${b.id}`,
  name: b.name,
  alternateName: b.shortName,
  description: b.description,
  url: `${business.url}${b.url}`,
  parentOrganization: { '@id': `${business.url}/#organization` }
}));

// Grupo LGO: UNA entidad, no dos.
//
// Esto eran dos nodos —una Organization y un ProfessionalService— con el mismo
// nombre, la misma URL, la misma dirección y el mismo teléfono, unidos por un
// `parentOrganization` que venía a decir que la empresa es hija de sí misma.
// Para un rastreador eso son dos candidatos a la misma entidad y la señal se
// reparte entre los dos.
//
// `ProfessionalService` desciende de `LocalBusiness`, que desciende de
// `Organization`, así que un solo nodo con los dos tipos es a la vez la
// organización raíz del ecosistema y el negocio con domicilio y horario. Todo
// lo que ya apuntaba a `#organization` —las sub-marcas, el sitio— sigue
// apuntando al mismo sitio, y `#localbusiness` no lo referenciaba nadie.
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${business.url}/#organization`,
  name: business.brand,
  description: business.description,
  url: business.url,
  // El favicon no sirve de logotipo: Google pide una imagen de verdad, y
  // `grupo-lgo.png` mide 629 × 246, por encima del mínimo que exige.
  logo: `${business.url}/images/logos/grupo-lgo.png`,
  image: `${business.url}/og-default.jpg`,
  email: business.email,
  telephone: business.phoneE164,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.locality,
    addressRegion: business.address.regionCode,
    postalCode: business.address.postalCode,
    addressCountry: business.address.countryCode
  },
  // VERIFICAR: coordenadas exactas de la sede. Las actuales llevan cuatro
  // decimales (unos 11 m de margen) y Google pide al menos cinco. No se
  // inventan dígitos: salen de Google Maps, con clic derecho sobre el edificio.
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude
  },
  areaServed: [
    { '@type': 'City', name: 'Guadalajara' },
    { '@type': 'City', name: 'Zapopan' },
    { '@type': 'AdministrativeArea', name: 'Jalisco' },
    { '@type': 'Country', name: 'México' }
  ],
  openingHoursSpecification: business.hours.openingHoursSpec,
  subOrganization: publishedSubBrands.map((b) => ({ '@id': `${business.url}/#${b.id}` })),
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: business.phoneE164,
    contactType: 'customer service',
    email: business.email,
    areaServed: 'MX',
    availableLanguage: ['Spanish']
  }]
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${business.url}/#website`,
  url: business.url,
  name: business.brand,
  inLanguage: 'es-MX',
  publisher: { '@id': `${business.url}/#organization` }
};

const baseLd: Record<string, unknown>[] = [
  organizationLd,
  websiteLd,
  ...subBrandOrgs
];
const extraLd = extraJsonLd
  ? (Array.isArray(extraJsonLd) ? extraJsonLd : [extraJsonLd])
  : [];
const allLd = [...baseLd, ...extraLd];
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <Seo title={title} description={description} path={path} canonical={canonical} ogImage={ogImage} noindex={noindex} type={type} />
  <JsonLd data={allLd} />
</head>
<body>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <CookieConsent />
  <MetaPixel viewContent={pixelViewContent} />

  <script>
    // Entrance choreography: una sola observación, sin scattered micro-interactions.
    if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
      const els = document.querySelectorAll('.reveal-up');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      els.forEach((el) => observer.observe(el));
    }
  </script>
</body>
</html>
